{
  "extends": [
    "development"
  ],
  "hints": {
    "no-inline-styles": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "scrollbar-width",
          "scrollbar-color",
          "scrollbar-width: thin",
          "user-select",
          "-webkit-overflow-scrolling",
          "scrollbar-width: none"
        ]
      }
    ],
    "css-prefix-order": "off",
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off"
      }
    ],
    "manifest-exists": "off",
    "apple-touch-icons": "off",
    "axe/forms": "off",
    "disown-opener": "off",
    "axe/parsing": [
      "default",
      {
        "duplicate-id-active": "off"
      }
    ]
  }
}